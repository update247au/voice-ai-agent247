OPENAI_API_KEY=sk-proj-xxx

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx

# Phone Lookup API
PHONE_LOOKUP_API_URL=https://api.update247.com/lookup-phone
PHONE_LOOKUP_API_KEY=xxx

# AssemblyAI (for call recording transcription)
ASSEMBLYAI_API_KEY=xxx
ASSEMBLYAI_ENABLED=true

# Call Log API (sends call data to external server at end of call)
CALL_LOG_API_ENABLED=true
CALL_LOG_API_URL=https://api.update247.com/call-log
CALL_LOG_API_KEY=xxx
CALL_LOG_ADMIN=AI Agent
CALL_LOG_ANSWER_BY=AI Agent
CALL_LOG_TIMEOUT_MS=10000

# Email Configuration
EMAIL_ENABLED=true

# SMTP Configuration (cPanel/Standard SMTP)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS=xxx
SMTP_SECURE=true

# AWS SES Configuration (alternative to SMTP)
# AWS_SES_ACCESS_KEY=xxx
# AWS_SES_SECRET_KEY=xxx
# AWS_SES_REGION=ap-southeast-2
# SES_FROM_EMAIL=noreply@yourdomain.com

# Email Recipients
# NOTIFY_EMAIL is the default/fallback email address
NOTIFY_EMAIL=support@update247.com.au

# Optional: Separate email addresses for different notification types
# If not set, falls back to NOTIFY_EMAIL
TRANSCRIPT_EMAIL=transcripts@update247.com.au
RECORDING_EMAIL=recordings@update247.com.au

# Test email routing (sends to TEST_EMAIL when caller matches TEST_CALLER_NUMBER)
TEST_EMAIL=test@update247.com.au
TEST_CALLER_NUMBER=+61423489798

# Google Cloud Storage (optional)
# GCS_BUCKET=your-bucket-name
